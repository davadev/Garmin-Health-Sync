tag-version-prefix=""
# Supply-chain policy: refuse to resolve a dependency version younger than this many
# days. Applies to `npm install`, `npm update`, `npm audit fix`. `npm ci` is NOT affected
# (it installs exactly what package-lock.json pins), so Dependabot's `cooldown:` in
# .github/dependabot.yml is the matching control for what lands in the lockfile. Keep both
# in step; check-release fails if either is removed. Needs npm >= 11.10 (older npm
# ignores or warns on the key).
#
# Deliberate exception for an urgent NON-security fix: add the package to
# `min-release-age-exclude[]=<name>` below, in the same PR, so it is visible in review.
# Never pass --min-release-age=0 in a commit or workflow.
min-release-age=14
min-release-age-exclude[]=brace-expansion
