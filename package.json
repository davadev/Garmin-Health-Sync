{
	"name": "garmin-health-sync",
	"version": "0.11.1",
	"description": "Sync Garmin Connect health data into Obsidian Daily Notes",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"typecheck:tests": "tsc -p tsconfig.test.json",
		"check:dead-code": "knip --production && knip --no-config-hints --include dependencies,unlisted,binaries,unresolved",
		"check-release": "node scripts/check-release.mjs",
		"lint:cloud-parity": "node scripts/lint-cloud-parity.mjs",
		"lint:css": "stylelint styles.css"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "9.30.1",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.3",
		"esbuild": "0.28.2",
		"eslint": "9.39.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.13.0",
		"happy-dom": "20.14.6",
		"jiti": "2.7.0",
		"knip": "6.41.0",
		"obsidian": "^1.14.4",
		"stylelint": "17.16.0",
		"stylelint-no-unsupported-browser-features": "8.1.2",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.71.1",
		"vitest": "5.0.3",
		"yaml": "2.9.1"
	},
	"allowScripts": {
		"esbuild": false
	}
}
